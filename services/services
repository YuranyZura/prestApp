import * as clienteModel from "../models/clientes.model.js";

export const getClientes = async () => {
  try {
    const clientes = await clienteModel.getAll();

    // 🔥 ejemplo: puedes transformar datos aquí
    return clientes.map(cliente => ({
      ...cliente,
      estado: cliente.deuda > 0 ? "pendiente" : "al_dia"
    }));

  } catch (error) {
    console.error("Error en service getClientes:", error);
    throw error;
  }
};