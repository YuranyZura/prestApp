# ===============================
# CONFIGURACIÓN GLOBAL
# ===============================

# Normalizar finales de línea (LF para compatibilidad multiplataforma)
* text=auto eol=lf

# ===============================
# ARCHIVOS DE CÓDIGO
# ===============================

*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.env text eol=lf

# ===============================
# ARCHIVOS DE CONFIGURACIÓN
# ===============================

*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# ===============================
# ARCHIVOS BINARIOS (NO TOCAR)
# ===============================

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

*.mp4 binary
*.mp3 binary
*.wav binary

*.zip binary
*.rar binary
*.7z binary

*.pdf binary

# ===============================
# ANDROID / WEBVIEW
# ===============================

*.apk binary
*.aab binary
*.keystore binary

# ===============================
# BASE DE DATOS / BACKUPS
# ===============================

*.sql text eol=lf

# ===============================
# LOGS (NO VERSIONAR BIEN)
# ===============================

*.log text eol=lf